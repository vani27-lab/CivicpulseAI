# Vision AI (never commit real keys)
AI_VISION_PROVIDER=anthropic
AI_VISION_API_KEY=
AI_VISION_API_URL=https://api.anthropic.com/v1/messages
AI_VISION_MODEL=claude-sonnet-4-6
AI_VISION_TIMEOUT_SECONDS=30
AI_VISION_MAX_TOKENS=600

# Limits and rules
AI_MAX_IMAGE_BYTES=5242880
AI_MAX_DESCRIPTION_CHARS=2000
AI_CONFIDENCE_THRESHOLD=0.70

# Saved-demo fallback
AI_DEMO_FALLBACK_ENABLED=true
AI_DEMO_RESULTS_PATH=data/saved_demo_results.json
