# Backend base URL (Module 1 FastAPI app). Leave empty to use same-origin / a dev proxy.
VITE_API_BASE_URL=http://localhost:8000
# Prefix for uploaded photos when the API returns relative URLs like /media/after/...
VITE_MEDIA_BASE_URL=http://localhost:8000

# Module 1 authentication (the officer app does not implement its own login system)
VITE_AUTH_TOKEN_KEY=civicpulse_token
VITE_AUTH_LOGIN_PATH=/auth/login
# json  -> POST {"email","password"}      form -> OAuth2 form {"username","password"}
VITE_AUTH_LOGIN_FORMAT=json
VITE_AUTH_ME_PATH=/auth/me

# Roles allowed into the officer area (must match backend M5_OFFICER_ROLES)
VITE_OFFICER_ROLES=officer,admin

# Map defaults: "lat,lng" and zoom. Falls back to the centre of India.
VITE_MAP_DEFAULT_CENTER=22.9734,78.6569
VITE_MAP_DEFAULT_ZOOM=5
