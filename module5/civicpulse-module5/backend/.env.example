# ---- Module 5 backend (append to the project's backend .env) ----
# Dependencies resolved from Module 1 (format: package.module:callable)
M5_GET_DB=app.db.session:get_db
M5_GET_CURRENT_USER=app.core.security:get_current_user

# Role names as stored in users.role
M5_OFFICER_ROLES=officer,admin
M5_ADMIN_ROLE=admin

# How statuses are spelled in the DB: snake (in_progress) or title (In Progress)
M5_STATUS_STYLE=snake
M5_ENABLE_REJECTED=true

# After-photo storage (mount this path as a Docker volume and serve it at M5_MEDIA_BASE_URL)
M5_UPLOAD_DIR=/data/uploads
M5_MEDIA_BASE_URL=/media
M5_MAX_UPLOAD_MB=8

# Module 4 integration
M4_DUPLICATE_SERVICE_MODULE=app.services.duplicate_service
M4_REROUTE_HOOK=

# Turn off if Module 1/4 already expose the same route
M5_MOUNT_HEATMAP=true
M5_MOUNT_DUPLICATE_ROUTES=true
