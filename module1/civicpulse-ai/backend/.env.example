# Used when you run the backend directly (without Docker).
# Copy this file to ".env" inside the backend folder.

# Local PostgreSQL on its normal port. If you use the Docker database from this
# project instead, change 5432 to 5433.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/civicpulse

JWT_SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads

# true = create demo users and demo complaints
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo@1234
