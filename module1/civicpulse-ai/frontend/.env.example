# Copy to ".env" in this folder if you want to change a value.

# Where the dev server forwards /api requests. Default = backend on your computer.
# (docker-compose sets this to http://backend:8000 for you.)
VITE_PROXY_TARGET=http://localhost:8000

# Show the "Try a demo account" buttons on the sign-in page. Set to false for a real launch.
VITE_SHOW_DEMO_LOGINS=true
