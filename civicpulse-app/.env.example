# Used by docker-compose.yml. Copy this file to ".env" (same folder) to change values.
# Docker works without it too: every value below is also the default.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicpulse

# Used to sign login tokens. Use a long random value outside of local demos.
JWT_SECRET_KEY=dev-secret-change-me

# true = create demo users and demo complaints on start-up
SEED_DEMO_DATA=true
