# Database (dev app only; the main project uses Module 1's session)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/civicpulse

# Duplicate detection
CP_DUPLICATE_RADIUS_M=50
CP_DUPLICATE_WINDOW_DAYS=30
CP_ELIGIBLE_STATUSES=submitted,acknowledged,in_progress
CP_MERGE_UNCLASSIFIED=false

# CLIP similarity (cosine). Defaults are uncalibrated starting points: tune on real photos.
CP_MERGE_SIMILARITY=0.92
CP_POSSIBLE_SIMILARITY=0.85
CP_CLIP_MODEL=clip-ViT-B-32

# GPS
CP_MAX_GPS_ACCURACY_M=100
CP_MAX_ACCURACY_AUTO_MERGE_M=50
CP_GPS_BBOX_ENABLED=true
CP_GPS_BBOX=6.0,68.0,38.0,98.0

# Location factor
CP_POI_RADIUS_M=200
CP_ROAD_MARKET_RADIUS_M=100
CP_PLACES_PATH=data/places.json

# Complaints / auth
CP_NEW_COMPLAINT_STATUS=submitted
CP_OFFICER_ROLES=officer,admin
CP_MAX_IMAGE_BYTES=10485760
